 <Window x:Class="WpfInchirieri.MainWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inchirieri Auto"
        Height="520"
        Width="850"
        Background="#E6CCFF"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- BUTOANE -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#B266FF"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#6600CC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- TEXT -->
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5,10,5,2"/>
        </Style>

        <!-- HEADER TABEL -->
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#6600CC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- RANDURI -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#E6CCFF"/>

            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex"
                         Value="1">
                    <Setter Property="Background"
                            Value="#F2E6FF"/>
                </Trigger>
            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENIU PRINCIPAL -->
        <Grid x:Name="GridMeniu">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLU -->
            <TextBlock Grid.Row="0"
               Text="Inchirieri Auto"
               FontSize="40"
               FontWeight="Bold"
               Foreground="#6600CC"
               HorizontalAlignment="Center"
               Margin="0,30,0,40"/>

            <!-- CONTINUT -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLOANA MASINI -->
                <StackPanel Grid.Column="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center">

                    <TextBlock Text="MASINI"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#6600CC"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                    <Button Content="Adauga masina"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToAdaugare"/>

                    <Button Content="Cautare masini"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToCautare"/>

                    <Button Content="Modificare masina"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToModificare"/>

                    <Button Content="Stergere masina"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToStergereMasina"/>

                </StackPanel>

                <!-- COLOANA CLIENTI -->
                <StackPanel Grid.Column="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center">

                    <TextBlock Text="CLIENTI"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#6600CC"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                    <Button Content="Adauga client"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToClienti"/>

                    <Button Content="Cautare client"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToClientSearch"/>

                    <Button Content="Modificare client"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToClientMod"/>

                    <Button Content="Stergere client"
                    Width="260"
                    Height="55"
                    FontSize="18"
                    Click="GoToClientDelete"/>

                </StackPanel>

            </Grid>

        </Grid>
        <!-- PAGINA ADAUGARE -->
            <Grid x:Name="GridAdaugare"
                  Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
            <ScrollViewer Grid.Column="0"
              VerticalScrollBarVisibility="Auto"
              Height="450">

                <StackPanel Margin="10">

                    <Button Content="⬅ Inapoi"
                Width="120"
                HorizontalAlignment="Left"
                Click="GoBack"/>

                    <Border Background="#F2E6FF"
                CornerRadius="15"
                Padding="10">

                        <StackPanel>

                            <TextBlock Text="Optiuni selectate"/>

                            <ListBox x:Name="lstOptiuni"
                         Height="80"
                         SelectionMode="Multiple"
                         Margin="5"/>

                            <TextBlock Text="Adaugare masina"
                           FontSize="18"
                           HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblMarca"
                           Text="Marca"/>

                            <TextBox x:Name="txtMarca"/>

                            <TextBlock x:Name="lblModel"
                           Text="Model"/>

                            <TextBox x:Name="txtModel"/>

                            <TextBlock x:Name="lblAn"
                           Text="An"/>

                            <TextBox x:Name="txtAn"/>

                            <TextBlock Text="Culoare"/>

                            <ComboBox x:Name="cbCuloare"
                          Height="28"/>

                            <TextBlock Text="Optiuni"/>

                            <CheckBox x:Name="chkTrapa"
                          Content="Trapa panoramica"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed"/>

                            <CheckBox x:Name="chkNav"
                          Content="Navigatie"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed"/>

                            <CheckBox x:Name="chkSuspensie"
                          Content="Suspensie reglabila"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed"/>

                            <CheckBox x:Name="chkIncalzire"
                          Content="Incalzire scaune"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed"/>

                            <CheckBox x:Name="chkSenzori"
                          Content="Senzori parcare"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed"/>

                            <TextBlock Text="Tip transmisie"/>

                            <StackPanel Orientation="Horizontal">

                                <RadioButton x:Name="rbManual"
                                 Content="Manuala"
                                 IsChecked="True"
                                 Margin="5"/>

                                <RadioButton x:Name="rbAutomat"
                                 Content="Automata"
                                 Margin="5"/>

                            </StackPanel>

                            <TextBlock Text="Data inchiriere"/>

                            <DatePicker x:Name="dpData"
                            SelectedDateFormat="Short"
                            Margin="5"/>

                            <Button Content="Adauga masina"
                        Click="AdaugaMasina_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- DREAPTA -->
                <Border Grid.Column="1"
                        Background="#F2E6FF"
                        CornerRadius="15"
                        Padding="10"
                        Margin="10">

                <DataGrid x:Name="dgMasiniAdaugare"
           ItemsSource="{Binding ElementName=dgMasini, Path=ItemsSource}"
                              AutoGenerateColumns="False"
                              RowHeight="35"
                              CanUserAddRows="False"
                              AlternationCount="2"
                              RowStyle="{StaticResource RowStyle}"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}"
                              AlternatingRowBackground="#F2E6FF"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Marca"
                                    Binding="{Binding Marca}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Model"
                                    Binding="{Binding Model}"
                                    Width="120"/>

                        <DataGridTextColumn Header="An"
                                    Binding="{Binding An}"
                                    Width="80"/>

                        <DataGridTextColumn Header="Culoare"
                                    Binding="{Binding CuloareMasina}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Optiuni"
                                    Binding="{Binding OptiuniMasina}"
                                    Width="200"/>

                        <DataGridTextColumn Header="Disponibil"
                                    Binding="{Binding Disponibila}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Transmisie"
                                    Binding="{Binding Transmisie}"
                                    Width="150"/>


                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            </Grid>

            <!-- PAGINA CAUTARE -->
            <Grid x:Name="GridCautare"
                  Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <StackPanel Grid.Column="0"
                            Margin="10">

                    <Button Content="⬅ Inapoi"
                            Width="120"
                            HorizontalAlignment="Left"
                            Click="GoBack"/>

                    <Border Background="#F2E6FF"
                            CornerRadius="15"
                            Padding="10"
                            Margin="0,10,0,10">

                        <StackPanel>

                            <TextBlock Text="Cautare dupa marca"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>

                            <TextBox x:Name="txtCautareMarca"
                                     Height="30"
                                     Margin="0,10,0,10"/>

                            <Button Content="Cauta"
                                    Height="35"
                                    Click="CautaMasina_Click"/>

                            <Button Content="Reset"
                                    Height="35"
                                    Click="ReseteazaLista_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
                        Background="#F2E6FF"
                        CornerRadius="15"
                        Padding="10"
                        Margin="10">

                    <DataGrid x:Name="dgMasini"
                              AutoGenerateColumns="False"
                              RowHeight="35"
                              CanUserAddRows="False"
                              AlternationCount="2"
                              RowStyle="{StaticResource RowStyle}"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}"
                              AlternatingRowBackground="#F2E6FF"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Marca"
                                                Binding="{Binding Marca}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Model"
                                                Binding="{Binding Model}"
                                                Width="120"/>

                            <DataGridTextColumn Header="An"
                                                Binding="{Binding An}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Culoare"
                                                Binding="{Binding CuloareMasina}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Optiuni"
                                                Binding="{Binding OptiuniMasina}"
                                                Width="200"/>

                            <DataGridTextColumn Header="Disponibil"
                                                Binding="{Binding Disponibila}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Transmisie"
                                                Binding="{Binding Transmisie}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

            <!-- PAGINA MODIFICARE -->
            <Grid x:Name="GridModificare"
                    Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              Height="450">

                    <StackPanel Margin="10">

                        <Button Content="⬅ Inapoi"
                                Width="120"
                                HorizontalAlignment="Left"
                                Click="GoBack"/>

                        <Border Background="#F2E6FF"
                                CornerRadius="15"
                                Padding="10">

                            <StackPanel>

                                <TextBlock Text="Modificare masina"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                                <TextBlock Text="Marca"/>
                                <TextBox x:Name="txtMarcaMod"/>

                                <TextBlock Text="Model"/>
                                <TextBox x:Name="txtModelMod"/>

                                <TextBlock Text="An"/>
                                <TextBox x:Name="txtAnMod"/>

                                <TextBlock Text="Culoare"/>
                                <ComboBox x:Name="cbCuloareMod"
                                            Height="28"/>

                                <TextBlock Text="Optiuni"/>

                                <CheckBox x:Name="chkTrapaMod"
                                            Content="Trapa panoramica"/>

                                <CheckBox x:Name="chkNavMod"
                                            Content="Navigatie"/>

                                <CheckBox x:Name="chkSuspensieMod"
                                            Content="Suspensie reglabila"/>

                                <CheckBox x:Name="chkIncalzireMod"
                                            Content="Incalzire scaune"/>

                                <CheckBox x:Name="chkSenzoriMod"
                                            Content="Senzori parcare"/>

                                <TextBlock Text="Tip transmisie"/>

                                <StackPanel Orientation="Horizontal">

                                    <RadioButton x:Name="rbManualMod"
                                     Content="Manuala"
                                     Margin="5"/>

                                    <RadioButton x:Name="rbAutomatMod"
                                     Content="Automata"
                                     Margin="5"/>

                                </StackPanel>

                                <Button Content="Salveaza modificarile"
                            Click="ModificaMasina_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
                        Background="#F2E6FF"
                        CornerRadius="15"
                        Padding="10"
                        Margin="10">

                <DataGrid x:Name="dgModificare"
                           AutoGenerateColumns="False"
                          RowHeight="35"
                                CanUserAddRows="False"
                                SelectionChanged="dgModificare_SelectionChanged"
                                AlternationCount="2"
                                RowStyle="{StaticResource RowStyle}"
                                ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                AlternatingRowBackground="#F2E6FF"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Marca"
                                Binding="{Binding Marca}"
                                Width="120"/>

                        <DataGridTextColumn Header="Model"
                                    Binding="{Binding Model}"
                                 Width="120"/>

                        <DataGridTextColumn Header="An"
                                            Binding="{Binding An}"
                                                Width="80"/>

                        <DataGridTextColumn Header="Culoare"
                             Binding="{Binding CuloareMasina}"
     Width="140"/>

                        <DataGridTextColumn Header="Optiuni"
     Binding="{Binding OptiuniMasina}"
     Width="300"/>

                        <DataGridTextColumn Header="Disponibil"
     Binding="{Binding Disponibila}"
     Width="120"/>

                        <DataGridTextColumn Header="Transmisie"
     Binding="{Binding Transmisie}"
     Width="150"/>


                    </DataGrid.Columns>

                </DataGrid>
                    
            </Border>

            </Grid>

            <!-- PAGINA STERGERE MASINA -->
            <Grid x:Name="GridStergereMasina"
      Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <StackPanel Grid.Column="0"
                Margin="10">

                    <Button Content="⬅ Inapoi"
                Width="120"
                Click="GoBack"/>

                    <Button Content="Sterge masina"
                Height="40"
                Margin="0,20,0,0"
                Click="StergeMasina_Click"/>

                </StackPanel>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
            Background="#F2E6FF"
            CornerRadius="15"
            Padding="10"
            Margin="10">

                    <DataGrid x:Name="dgStergereMasina"
                  AutoGenerateColumns="False"
                  RowHeight="35"
                  CanUserAddRows="False"
                  AlternationCount="2"
                  RowStyle="{StaticResource RowStyle}"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  AlternatingRowBackground="#F2E6FF">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Marca"
                                    Binding="{Binding Marca}"
                                    Width="120"/>

                            <DataGridTextColumn Header="Model"
                                    Binding="{Binding Model}"
                                    Width="120"/>

                            <DataGridTextColumn Header="An"
                                    Binding="{Binding An}"
                                    Width="80"/>

                            <DataGridTextColumn Header="Culoare"
                                    Binding="{Binding CuloareMasina}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Optiuni"
                                            Binding="{Binding OptiuniMasina}"
                                            Width="300"/>

                        <DataGridTextColumn Header="Disponibil"
                            Binding="{Binding Disponibila}"
                            Width="120"/>

                            <DataGridTextColumn Header="Transmisie"
                                    Binding="{Binding Transmisie}"
                                    Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

            <!-- ADAUGARE CLIENT -->
            <Grid x:Name="GridClientiAdd"
                  Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <StackPanel Grid.Column="0"
          Margin="10">

                    <Button Content="⬅ Inapoi"
          Width="120"
          HorizontalAlignment="Left"
          Click="BackToClientMenu"/>

                    <Border Background="#F2E6FF"
          CornerRadius="15"
          Padding="10"
          Margin="0,10,0,0">

                        <StackPanel>

                            <TextBlock Text="Adaugare client"
                     FontSize="18"
                     HorizontalAlignment="Center"/>

                            <TextBlock Text="Nume"/>
                            <TextBox x:Name="txtNumeAdd"/>

                            <TextBlock Text="Prenume"/>
                            <TextBox x:Name="txtPrenumeAdd"/>

                            <TextBlock Text="CNP"/>
                            <TextBox x:Name="txtCNPAdd"/>

                            <Button Content="Adauga"
                  Click="AdaugaClient_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
      Background="#F2E6FF"
      CornerRadius="15"
      Padding="10"
      Margin="10">
                    <DataGrid x:Name="dgClientiAdd"
          ItemsSource="{Binding ElementName=dgClientiMod, Path=ItemsSource}"
          AutoGenerateColumns="False"
          RowHeight="35"
          CanUserAddRows="False"
          AlternationCount="2"
          RowStyle="{StaticResource RowStyle}"
          ColumnHeaderStyle="{StaticResource HeaderStyle}"
          AlternatingRowBackground="#F2E6FF"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nume"
                            Binding="{Binding Nume}"
                            Width="150"/>

                            <DataGridTextColumn Header="Prenume"
                            Binding="{Binding Prenume}"
                            Width="150"/>

                            <DataGridTextColumn Header="CNP"
                            Binding="{Binding CNP}"
                            Width="200"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

            <!-- MODIFICARE CLIENT -->
            <Grid x:Name="GridClientiMod"
Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <ScrollViewer Grid.Column="0"
            VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <Button Content="⬅ Inapoi"
              Width="120"
              HorizontalAlignment="Left"
              Click="BackToClientMenu"/>

                        <Border Background="#F2E6FF"
              CornerRadius="15"
              Padding="10">

                            <StackPanel>

                                <TextBlock Text="Modificare client"
                         FontSize="18"
                         HorizontalAlignment="Center"/>

                                <TextBlock Text="Nume"/>
                                <TextBox x:Name="txtNumeMod"/>

                                <TextBlock Text="Prenume"/>
                                <TextBox x:Name="txtPrenumeMod"/>

                                <TextBlock Text="CNP"/>
                                <TextBox x:Name="txtCNPMod"/>

                                <Button Content="Salveaza modificarile"
                      Click="ModificaClient_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
      Background="#F2E6FF"
      CornerRadius="15"
      Padding="10"
      Margin="10">

                    <DataGrid x:Name="dgClientiMod"
          AutoGenerateColumns="False"
          SelectionChanged="dgClienti_SelectionChanged"
          RowHeight="35"
          CanUserAddRows="False"
          AlternationCount="2"
          RowStyle="{StaticResource RowStyle}"
          ColumnHeaderStyle="{StaticResource HeaderStyle}"
          AlternatingRowBackground="#F2E6FF"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nume"
                            Binding="{Binding Nume}"
                            Width="150"/>

                            <DataGridTextColumn Header="Prenume"
                            Binding="{Binding Prenume}"
                            Width="150"/>

                            <DataGridTextColumn Header="CNP"
                            Binding="{Binding CNP}"
                            Width="200"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

            <!-- CAUTARE CLIENT -->
            <Grid x:Name="GridClientiSearch"
Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <StackPanel Grid.Column="0"
          Margin="10">

                    <Button Content="⬅ Inapoi"
          Width="120"
          HorizontalAlignment="Left"
          Click="BackToClientMenu"/>

                    <Border Background="#F2E6FF"
          CornerRadius="15"
          Padding="10"
          Margin="0,10,0,0">

                        <StackPanel>

                            <TextBlock Text="Cautare client"
                     FontSize="18"
                     HorizontalAlignment="Center"/>

                            <TextBox x:Name="txtCautareClient"/>

                            <Button Content="Cauta"
                  Click="CautaClient_Click"/>

                            <Button Content="Reset"
                  Click="ResetClienti_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
      Background="#F2E6FF"
      CornerRadius="15"
      Padding="10"
      Margin="10">

                    <DataGrid x:Name="dgClientiSearch"
          AutoGenerateColumns="False"
          RowHeight="35"
          CanUserAddRows="False"
          AlternationCount="2"
          RowStyle="{StaticResource RowStyle}"
          ColumnHeaderStyle="{StaticResource HeaderStyle}"
          AlternatingRowBackground="#F2E6FF"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nume"
                            Binding="{Binding Nume}"
                            Width="150"/>

                            <DataGridTextColumn Header="Prenume"
                            Binding="{Binding Prenume}"
                            Width="150"/>

                            <DataGridTextColumn Header="CNP"
                            Binding="{Binding CNP}"
                            Width="200"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

            <!-- STERGERE CLIENT -->
            <Grid x:Name="GridClientiDelete"
Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STANGA -->
                <StackPanel Grid.Column="0"
          Margin="10">

                    <Button Content="⬅ Inapoi"
          Width="120"
          HorizontalAlignment="Left"
          Click="BackToClientMenu"/>

                    <Button Content="Sterge client"
          Height="40"
          Margin="0,10,0,0"
          Click="StergeClient_Click"/>

                </StackPanel>

                <!-- DREAPTA -->
                <Border Grid.Column="1"
      Background="#F2E6FF"
      CornerRadius="15"
      Padding="10"
      Margin="10">

                    <DataGrid x:Name="dgClientiDelete"
          AutoGenerateColumns="False"
          RowHeight="35"
          CanUserAddRows="False"
          AlternationCount="2"
          RowStyle="{StaticResource RowStyle}"
          ColumnHeaderStyle="{StaticResource HeaderStyle}"
          AlternatingRowBackground="#F2E6FF"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nume"
                            Binding="{Binding Nume}"
                            Width="150"/>

                            <DataGridTextColumn Header="Prenume"
                            Binding="{Binding Prenume}"
                            Width="150"/>

                            <DataGridTextColumn Header="CNP"
                            Binding="{Binding CNP}"
                            Width="200"/>

                        </DataGrid.Columns>

                    </DataGrid>
                    
                </Border>

            </Grid>

    </Grid>

</Window>